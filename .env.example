# =====================================================================
#  Copie para .env e preencha com os SEUS dados. Nunca commite o .env.
# =====================================================================

# --- Telegram ---
# Token do bot criado no @BotFather (/newbot)
BOT_TOKEN=123456789:SEU_TOKEN_DO_BOTFATHER_AQUI
# (opcional) segredo pra validar os updates do Telegram (header X-Telegram-Bot-Api-Secret-Token).
# Use o mesmo valor ao configurar o webhook do Telegram.
TELEGRAM_WEBHOOK_SECRET=

# --- URL pública (produção) ---
# URL pública do app com HTTPS, ex: https://vip2026bot.vercel.app
# Usada pra montar o webhook_url das cobranças quando WEBHOOK_URL está vazio.
PUBLIC_URL=

# --- Epague ---
# Chave de API gerada no painel da Epague (Dashboard / Integrações / API Keys).
# Crie a chave SOMENTE com a permissão "Cobranças" — a chave do bot não deve
# poder sacar (princípio do menor privilégio; o próprio painel recomenda).
EPAGUE_API_KEY=SUA_API_KEY_DA_EPAGUE_AQUI
# (opcional) URL base da API. Padrão: https://epague.net
# EPAGUE_BASE_URL=https://epague.net
# URL pública que a Epague chama quando o pagamento muda de status.
# Em teste local use o ngrok, ex: https://abc123.ngrok.io/webhook/epague
WEBHOOK_URL=
# (opcional, recomendado) secret gerado em Dashboard / Integrações / Webhooks.
# O webhook.py valida a assinatura HMAC (x-webhook-signature) quando preenchido.
EPAGUE_WEBHOOK_SECRET=

# --- Acesso VIP ---
# Link de convite do grupo/canal VIP, enviado ao usuário após o pagamento
VIP_INVITE_LINK=https://t.me/+SEU_LINK_DE_CONVITE_AQUI

# --- Boas-vindas (opcional) ---
# Vídeo de apresentação enviado no /start (file_id, URL ou caminho local).
# Vazio = não envia vídeo.
WELCOME_VIDEO=

# --- Planos (opcional) ---
# JSON com os planos. Se vazio, usa os padrões de config.py.
# Exemplo:
# PLANS_JSON=[{"id":"semanal","name":"Plano Semanal","price_cents":999,"description":"7 dias de acesso","days":7}]
PLANS_JSON=

# --- Servidor do webhook ---
PORT=5000
