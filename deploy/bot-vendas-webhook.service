[Unit]
Description=Webhook Epague (Flask/gunicorn)
After=network.target

[Service]
WorkingDirectory=/opt/bot-vendas
ExecStart=/opt/bot-vendas/venv/bin/gunicorn webhook:app -b 0.0.0.0:5000 --workers 2
Restart=always
RestartSec=5
EnvironmentFile=/opt/bot-vendas/.env

[Install]
WantedBy=multi-user.target
